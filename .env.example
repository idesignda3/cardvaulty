# Application
APP_URL=http://localhost:3000
# Auth.js also reads NEXTAUTH_URL; keep in sync with APP_URL for OAuth callbacks
NEXTAUTH_URL=http://localhost:3000
NODE_ENV=development

# Auth (generate a long random string for production: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-secret
# Required behind reverse proxies / Docker nginx
AUTH_TRUST_HOST=true

# Optional Google OAuth — leave blank to hide the Google button
# In Google Cloud Console, set authorized redirect URI to:
#   {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres
POSTGRES_USER=cardvaulty
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=cardvaulty
# Docker Compose service hostname is "postgres". For local npm dev against compose DB use localhost:5432
DATABASE_URL=postgresql://cardvaulty:change-me-db-password@localhost:5432/cardvaulty

# Redis
REDIS_URL=redis://localhost:6379

# Pokémon TCG API (https://dev.pokemontcg.io/) — optional but recommended for rate limits
POKEMONTCG_API_KEY=
